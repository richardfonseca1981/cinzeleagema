VITE_API_URL="http://localhost:3334"

# Base das URLs de <link rel="canonical"> (ver src/components/Seo.tsx) — host
# com "www", sem barra final. Opcional: o código já tem esse valor como
# padrão; defina aqui só se o domínio mudar.
# VITE_SITE_URL="https://www.cinzeleagema.com.br"

# Landing page pública — placeholders, ajustar quando os dados reais existirem
VITE_WHATSAPP_NUMBER="5500000000000"
VITE_CONTACT_EMAIL="contato@cinzeleagema.com.br"

# Opcional — o código já tem um valor padrão (grupo de ofertas exclusivas);
# só defina aqui se o link do grupo mudar.
# VITE_WHATSAPP_GROUP_URL="https://chat.whatsapp.com/KN60WlSdW9K9yQNLna5kHy"

# GA4 (ver src/lib/analytics.ts) — SEM valor padrão de propósito: sem essa
# variável, o site funciona normalmente e o analytics simplesmente não
# carrega (nunca quebra a build). Só tem efeito em build de produção
# (`vite build`), nunca em dev/test. Não é segredo (vai pro bundle do
# cliente), mas também não é inventado — pegue o Measurement ID real na
# propriedade GA4 (formato "G-XXXXXXXXXX").
# VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
