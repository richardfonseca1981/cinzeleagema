generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  role         String   @default("admin")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Categorias/subcategorias servem apenas para organização, navegação e
// filtro do catálogo — não devem carregar campos técnicos variáveis por
// categoria (esse conceito, attributeSchema/attributes, foi removido
// intencionalmente e não deve voltar).
model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique

  // Ordem de exibição fixa definida pelo cliente — só o seed altera; não há
  // interface para editar categorias/posições.
  position Int @default(0)

  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id   String @id @default(cuid())
  name String
  slug String @unique

  // Ordem de exibição fixa dentro da categoria — mesma regra da posição da Category.
  position Int @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  products Product[]

  @@index([categoryId])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  // Tradução automática (Claude Haiku 4.5) disparada ao criar/editar o
  // produto — null quando ainda não traduzido ou quando a tradução falhou;
  // nesse caso o site público cai para name/description (PT) mesmo com
  // idioma em EN. Nunca preenchidos manualmente pelo admin.
  nameEn        String?
  descriptionEn String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Null quando a categoria selecionada não tem subcategorias.
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  price Decimal @db.Decimal(10, 2)
  sku   String? @unique

  // Peso e tamanho se aplicam a qualquer peça, independente da categoria —
  // por isso são colunas fixas, diferente dos campos técnicos variáveis em
  // `attributes` (quilate, corte, claridade etc.). Default 0 apenas para
  // não quebrar registros existentes na migration; cadastros novos via
  // formulário sempre informam um valor real (validado no Zod).
  weightGrams Decimal @default(0) @db.Decimal(10, 2)
  sizeCm      Decimal @default(0) @db.Decimal(10, 2)

  // Estoque opcional — controlado por flag, não por presença/ausência de dado.
  // Aqui cada peça costuma ser única: trackStock = false (peça única, sem
  // controle de quantidade) ou trackStock = true + stockQty = 1.
  trackStock Boolean @default(false)
  stockQty   Int? // null quando trackStock = false

  // Dimensões reais da caixa de envio — opcionais. Quando ausentes, o
  // estimador de frete (lib/shipping/packageEstimator.ts) calcula uma caixa
  // cúbica a partir de sizeCm + folga configurável. Preenchidos manualmente
  // no admin só para corrigir casos em que a estimativa automática erraria
  // (peça muito achatada/alongada, embalagem especial etc).
  packageLengthCm Decimal? @db.Decimal(10, 2)
  packageWidthCm  Decimal? @db.Decimal(10, 2)
  packageHeightCm Decimal? @db.Decimal(10, 2)

  images ProductImage[]

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([subcategoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String // URL pública no Cloudflare R2
  key      String // chave do objeto no bucket R2 (para permitir exclusão futura)
  position Int    @default(0)

  // Preenchidos quando um tratamento de foto por IA é confirmado — guardam a
  // URL/key da versão anterior para permitir desfazer (um único nível).
  previousUrl String?
  previousKey String?

  createdAt DateTime @default(now())

  @@index([productId])
}
