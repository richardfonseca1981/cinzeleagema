# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/site_pedras_preciosas?schema=public"

# Opcional: banco separado usado pelos testes de integração (npm run test -w backend).
# Se ausente, os testes usam o mesmo DATABASE_URL acima (não recomendado em produção).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5436/site_pedras_preciosas_test?schema=public"

# Servidor
PORT=3334
NODE_ENV=development

# CORS — origens permitidas, separadas por vírgula (frontend público + admin)
CORS_ORIGIN="http://localhost:5174,http://localhost:5173,https://cinzeleagema.com.br,https://www.cinzeleagema.com.br"

# Autenticação
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="8h"

# Cloudflare R2 (compatível com S3)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="site-pedras-preciosas"
# Endpoint S3 do R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# URL pública do bucket (domínio customizado ou r2.dev), usada para montar as URLs salvas em ProductImage.url
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Tratamento de foto por IA (Claude Haiku 4.5) — rotas retornam 503 se ausente
ANTHROPIC_API_KEY=""

# Microserviço de remoção de fundo (rembg), ver README para subir via Docker
REMBG_SERVICE_URL="http://localhost:8001"
# Opcional: segredo compartilhado enviado no header X-Internal-Secret;
# deixe vazio em desenvolvimento local se o serviço não exigir autenticação
REMBG_SERVICE_SECRET=""

# FluxioDesk — encaminhamento de pedidos do catálogo público (sem pagamento no site).
# Se ausentes, POST /api/orders responde delivered=false e o site cai para o link do WhatsApp.
FLUXIODESK_API_URL=""
FLUXIODESK_API_KEY=""

# Frete nacional — Melhor Envio (só o endpoint de cálculo/cotação, sem custo,
# nunca compra etiqueta). Se token ou CEP de origem ausentes, POST
# /api/shipping/quote responde "indisponível" (reason "not_configured") em
# vez de derrubar o servidor. Gerado em https://melhorenvio.com.br (ou
# https://sandbox.melhorenvio.com.br em modo sandbox) > Gerenciar > Tokens.
# ATENÇÃO: o token do Melhor Envio expira periodicamente e precisa ser
# renovado manualmente no painel deles — ver aviso em CONTEXT.md.
MELHOR_ENVIO_TOKEN=""
# Formato exigido pela Melhor Envio: "Nome da aplicação (email técnico)"
MELHOR_ENVIO_USER_AGENT="Cinzel e a Gema (contato@cinzeleagema.com.br)"
# "true" usa a API de testes (sandbox.melhorenvio.com.br, cotações fictícias); "false" usa produção
MELHOR_ENVIO_SANDBOX="false"
# CEP de origem dos envios (onde o produto é despachado), só dígitos
SHIPPING_ORIGIN_CEP=""
# Caixa fixa única usada em todo pedido (comprimento x largura x altura, cm)
SHIPPING_BOX_LENGTH_CM=40
SHIPPING_BOX_WIDTH_CM=30
SHIPPING_BOX_HEIGHT_CM=25
# Peso da embalagem vazia (gramas), somado uma vez ao peso das peças
SHIPPING_PACKAGING_WEIGHT_G=300

# Mercado Livre (Fase 0 — conexão/leitura, sem publicação de anúncios).
# Tudo opcional no boot: sem essas variáveis, o backend sobe normalmente e as
# rotas /api/admin/mercadolivre/* respondem 503 "Integração Mercado Livre não
# configurada" em vez de derrubar o servidor (ver lib/env.ts e
# lib/mercadoLivre/crypto.ts).
# App ID e Client Secret: criados em developers.mercadolivre.com.br > "Minhas
# aplicações" > sua aplicação > "Informações básicas".
ML_APP_ID=""
ML_CLIENT_SECRET=""
# Deve ser IDÊNTICO ao configurado na aplicação (URL estática, sem query
# string variável — ver docs "Autenticação e Autorização"). Nesta Fase 0,
# deve apontar para a página do admin do FRONTEND (não do backend) que lê
# code/state da querystring e repassa ao backend já autenticado
# (Authorization: Bearer do admin logado): <URL do admin>/admin/mercadolivre/callback
# — ex.: "https://admin.cinzeleagema.com.br/admin/mercadolivre/callback".
# Ver CONTEXT.md e frontend/src/pages/MercadoLivreCallback.tsx.
ML_REDIRECT_URI=""
# "test" usa um usuário de teste do Mercado Livre (criado via
# POST /users/test_user) para autorizar o app sem afetar a conta real;
# "prod" usa a conta real do vendedor. Nunca "prod" nesta fase.
ML_ENV="test"
# Chave AES-256-GCM que cifra accessToken/refreshToken em repouso no banco —
# precisa ser EXATAMENTE 32 bytes (256 bits) codificados em base64, usada
# como está (sem derivação/hash); tamanho ou base64 incorreto faz
# encryptToken/decryptToken lançarem erro claro em vez de usar uma chave
# fraca. Gere com
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
# e NUNCA reaproveite entre ambientes.
ML_TOKEN_ENC_KEY=""
# Fase 1B (publicação) — kill switch global. "false" (padrão, inclusive em
# produção até decisão explícita em contrário) força toda tentativa de
# publicar/pausar/encerrar a cair em dry-run (cliente simulado, nenhuma
# chamada real ao Mercado Livre), mesmo com conta conectada e peça apta.
ML_PUBLISH_ENABLED="false"
# Tipo de anúncio (ex.: "gold_special" — SUPOSIÇÃO, não verificado) que
# depende do plano contratado pelo vendedor no Mercado Livre. Vazio por
# padrão DE PROPÓSITO: publicar com o tipo errado tem custo real
# (exposição/tarifa), então o builder do payload recusa publicar sem este
# valor configurado em vez de assumir um "razoável" (ver publisherPayload.ts).
ML_LISTING_TYPE_ID=""
# Limite de tamanho da descrição estendida do anúncio (ver
# lib/mercadoLivre/descriptionBuilder.ts). SUPOSIÇÃO não verificada: o
# limite real de plain_text em POST /items/{id}/description nunca foi
# confirmado contra a doc atual (mesmo bloqueio 403 — ver categoryFixture.ts).
ML_DESCRIPTION_MAX_CHARS="5000"
# Presets de caixa de embalagem (ver lib/mercadoLivre/packagePresets.ts).
# SUPOSIÇÃO FORTE, não verificada: dimensões reais das caixas do cliente e o
# formato de shipping.dimensions do Mercado Livre nunca foram confirmados
# (mesmo bloqueio 403 — ver categoryFixture.ts). Acima de
# ML_PACKAGE_MAX_SIZE_CM/ML_PACKAGE_MAX_WEIGHT_G a peça é bloqueada até um
# override manual existir (nunca publica com caixa "chutada").
ML_PACKAGE_WEIGHT_MARGIN_G="300"
ML_PACKAGE_MAX_SIZE_CM="60"
ML_PACKAGE_MAX_WEIGHT_G="15000"
ML_PACKAGE_BOX_P_LENGTH_CM="20"
ML_PACKAGE_BOX_P_WIDTH_CM="16"
ML_PACKAGE_BOX_P_HEIGHT_CM="12"
ML_PACKAGE_BOX_M_LENGTH_CM="35"
ML_PACKAGE_BOX_M_WIDTH_CM="28"
ML_PACKAGE_BOX_M_HEIGHT_CM="20"
ML_PACKAGE_BOX_G_LENGTH_CM="50"
ML_PACKAGE_BOX_G_WIDTH_CM="40"
ML_PACKAGE_BOX_G_HEIGHT_CM="30"
ML_PACKAGE_BOX_GG_LENGTH_CM="65"
ML_PACKAGE_BOX_GG_WIDTH_CM="50"
ML_PACKAGE_BOX_GG_HEIGHT_CM="40"

# Base da URL pública de produto usada pelo script de auditoria do Mercado
# Livre (npm run audit:mercadolivre, coluna url_publica do CSV) — mesmo host
# do <link rel="canonical"> do frontend (VITE_SITE_URL), sempre com "www" e
# sem barra final. Opcional: o código já usa este valor como padrão.
PUBLIC_SITE_URL="https://www.cinzeleagema.com.br"
