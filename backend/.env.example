# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/site_pedras_preciosas?schema=public"

# Opcional: banco separado usado pelos testes de integração (npm run test -w backend).
# Se ausente, os testes usam o mesmo DATABASE_URL acima (não recomendado em produção).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5436/site_pedras_preciosas_test?schema=public"

# Servidor
PORT=3334
NODE_ENV=development

# CORS — origens permitidas, separadas por vírgula (frontend público + admin)
CORS_ORIGIN="http://localhost:5174,http://localhost:5173,https://cinzeleagema.com.br,https://www.cinzeleagema.com.br"

# Autenticação
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="8h"

# Cloudflare R2 (compatível com S3)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="site-pedras-preciosas"
# Endpoint S3 do R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# URL pública do bucket (domínio customizado ou r2.dev), usada para montar as URLs salvas em ProductImage.url
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Tratamento de foto por IA (Claude Haiku 4.5) — rotas retornam 503 se ausente
ANTHROPIC_API_KEY=""

# Microserviço de remoção de fundo (rembg), ver README para subir via Docker
REMBG_SERVICE_URL="http://localhost:8001"
# Opcional: segredo compartilhado enviado no header X-Internal-Secret;
# deixe vazio em desenvolvimento local se o serviço não exigir autenticação
REMBG_SERVICE_SECRET=""

# FluxioDesk — encaminhamento de pedidos do catálogo público (sem pagamento no site).
# Se ausentes, POST /api/orders responde delivered=false e o site cai para o link do WhatsApp.
FLUXIODESK_API_URL=""
FLUXIODESK_API_KEY=""

# Frete nacional — Melhor Envio (só o endpoint de cálculo/cotação, sem custo,
# nunca compra etiqueta). Se token ou CEP de origem ausentes, POST
# /api/shipping/quote responde "indisponível" (reason "not_configured") em
# vez de derrubar o servidor. Gerado em https://melhorenvio.com.br (ou
# https://sandbox.melhorenvio.com.br em modo sandbox) > Gerenciar > Tokens.
# ATENÇÃO: o token do Melhor Envio expira periodicamente e precisa ser
# renovado manualmente no painel deles — ver aviso em CONTEXT.md.
MELHOR_ENVIO_TOKEN=""
# Formato exigido pela Melhor Envio: "Nome da aplicação (email técnico)"
MELHOR_ENVIO_USER_AGENT="Cinzel e a Gema (contato@cinzeleagema.com.br)"
# "true" usa a API de testes (sandbox.melhorenvio.com.br, cotações fictícias); "false" usa produção
MELHOR_ENVIO_SANDBOX="false"
# CEP de origem dos envios (onde o produto é despachado), só dígitos
SHIPPING_ORIGIN_CEP=""
# Peso estimado da embalagem (gramas), somado ao peso da peça ao cotar frete
SHIPPING_PACKAGING_WEIGHT_G=200
# Folga (cm) adicionada por lado ao estimar uma caixa cúbica a partir do tamanho da peça
SHIPPING_PADDING_CM=3
