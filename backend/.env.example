# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/site_pedras_preciosas?schema=public"

# Opcional: banco separado usado pelos testes de integração (npm run test -w backend).
# Se ausente, os testes usam o mesmo DATABASE_URL acima (não recomendado em produção).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5436/site_pedras_preciosas_test?schema=public"

# Servidor
PORT=3334
NODE_ENV=development

# CORS — origem do frontend admin
CORS_ORIGIN="http://localhost:5174"

# Autenticação
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="8h"

# Cloudflare R2 (compatível com S3)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="site-pedras-preciosas"
# Endpoint S3 do R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# URL pública do bucket (domínio customizado ou r2.dev), usada para montar as URLs salvas em ProductImage.url
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Tratamento de foto por IA (Claude Haiku 4.5) — rotas retornam 503 se ausente
ANTHROPIC_API_KEY=""

# Microserviço de remoção de fundo (rembg), ver README para subir via Docker
REMBG_SERVICE_URL="http://localhost:8001"
# Opcional: segredo compartilhado enviado no header X-Internal-Secret;
# deixe vazio em desenvolvimento local se o serviço não exigir autenticação
REMBG_SERVICE_SECRET=""
